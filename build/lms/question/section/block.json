{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "mine-cloudvod/question-section",
  "title": "Question Sections",
  "category": "mine",
  "icon": "layout",
  "description": "Show a list of question sections.",
  "textdomain": "mine-cloudvod",
  "attributes": {
    "parentPostId": {
      "type": "number",
      "default": 0
    },
    "isChapter": {
      "type": "boolean",
      "default": false
    }
  },
  "supports": {
    "align": [
      "wide",
      "full"
    ],
    "interactivity": true,
    "layout": true,
    "html": false,
    "inserter": true,
    "multiple": true,
    "reusable": true,
    "container": true,
    "blockBindings": true
  },
  "render": "file:./render.php",
  "editorScript": "file:./index.js",
  "viewStyle": "file:./view.css",
  "viewScript": [
    "file:./view.js",
    "jquery",
    "mcv_layer"
  ]
}